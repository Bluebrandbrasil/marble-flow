rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- BASIC HELPERS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.superadmin == true || 
        getUserData().role == "superadmin"
      );
    }
    
    function isApprovedUser() {
      return isAuthenticated() && (
        isSuperAdmin() || 
        getUserData().status == "approved"
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function belongsToCompany(companyId) {
      return isApprovedUser() && (
        getUserData().companyId == companyId || 
        isSuperAdmin()
      );
    }

    // --- HISTORY PROTECTION HELPERS ---
    function isUnmodified(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    function isHistoricalFieldsPreserved() {
      return isUnmodified('finalProductionSnapshot') &&
             isUnmodified('finalizedAt') &&
             isUnmodified('productionStartedAt') &&
             isUnmodified('productionCompletedAt') &&
             isUnmodified('installationStartedAt') &&
             isUnmodified('installationCompletedAt') &&
             isUnmodified('companyId') &&
             isUnmodified('clientId') &&
             isUnmodified('contractId');
    }

    // --- COLLECTION RULES ---

    // Users: Can read/write their own profile. SuperAdmin can see all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      
      allow create: if isAuthenticated() && isOwner(userId) && (
        // Case A: Registering a new company
        (request.resource.data.role == 'company_admin' && 
         request.resource.data.status == 'pending' &&
         !exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)) &&
         existsAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId))) ||
        
        // Case B: Accepting an invitation (initial document creation as pending)
        (request.resource.data.status == 'pending' &&
         get(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)).data.status == 'pending' &&
         get(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)).data.email == request.auth.token.email &&
         request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)).data.role &&
         request.resource.data.companyId == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)).data.companyId)
      );
      
      allow update: if isSuperAdmin() || (
        isOwner(userId) && (
          // Normal profile edits (name, photo, etc.) - cannot alter security properties
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyId', 'status', 'permissions', 'isSuperAdmin', 'createdAt', 'inviteToken'])) ||
          
          // Accepting invite: can promote status from pending to approved if the invite is marked as accepted
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
           request.resource.data.status == 'approved' &&
           resource.data.status == 'pending' &&
           get(/databases/$(database)/documents/invites/$(resource.data.inviteToken)).data.status == 'accepted' &&
           get(/databases/$(database)/documents/invites/$(resource.data.inviteToken)).data.acceptedByUid == userId)
        )
      );
      
      allow delete: if isSuperAdmin();

      match /notificationTokens/{tokenId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }
    }
    
    // Companies: Tenant isolation.
    match /companies/{companyId} {
      allow read: if belongsToCompany(companyId);
      allow create: if isAuthenticated(); // Allow creation during Register
      allow update: if belongsToCompany(companyId);
      allow delete: if isSuperAdmin();

      match /{allPaths=**} {
        allow read, write: if belongsToCompany(companyId);
      }
    }

    match /reactivation_requests/{docId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSuperAdmin();
    }

    // Orders (pedidos)
    match /pedidos/{docId} {
      // ERP-authenticated access
      allow read, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );

      // Safe Updates (Protecting Historical Fields)
      allow update: if isApprovedUser() && 
        (isSuperAdmin() || resource.data.companyId == getUserData().companyId) &&
        isHistoricalFieldsPreserved();

      // Public access via Secure Proxy (public_contract_links)
      allow update: if (
        request.resource.data.signatureToken == resource.data.signatureToken &&
        (
          // Action: Mark as viewed
          (request.resource.data.contractStatus == 'viewed' && resource.data.contractStatus == 'pending') ||
          // Action: Client Signature
          (request.resource.data.contractStatus == 'signed' && resource.data.contractStatus in ['pending', 'viewed', 'company_signed'])
        )
      );

      // Immutable cycle subcollection
      match /completion_cycles/{cycleId} {
        allow read: if isApprovedUser() && (
          isSuperAdmin() || 
          get(/databases/$(database)/documents/pedidos/$(docId)).data.companyId == getUserData().companyId
        );
        allow create: if isApprovedUser() && 
          (isSuperAdmin() || get(/databases/$(database)/documents/pedidos/$(docId)).data.companyId == getUserData().companyId) &&
          request.resource.data.finalizedBy == request.auth.uid &&
          get(/databases/$(database)/documents/pedidos/$(docId)).data.status == 'finalizado';
        allow update, delete: if false;
      }

      // Append-only history subcollection
      match /production_history/{historyId} {
        allow read: if isApprovedUser() && (
          isSuperAdmin() || 
          get(/databases/$(database)/documents/pedidos/$(docId)).data.companyId == getUserData().companyId
        );
        allow create: if isApprovedUser() && 
          (isSuperAdmin() || get(/databases/$(database)/documents/pedidos/$(docId)).data.companyId == getUserData().companyId) &&
          request.resource.data.changedBy == request.auth.uid &&
          request.resource.data.orderId == docId;
        allow update, delete: if false;
      }
    }

    // Contracts (contratos)
    match /contratos/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
      
      // Public access for signing (token-based, no direct read allowed)
      allow update: if (
        request.resource.data.signatureToken == resource.data.signatureToken &&
        request.resource.data.contractStatus == 'signed' && 
        resource.data.contractStatus in ['sent', 'viewed', 'pending', 'company_signed'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contractStatus', 'signedAt', 'signatureData', 'clientSignature', 'signatureToken', 'history'
        ])
      );
    }

    // Quotes (orcamentos)
    match /orcamentos/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );

      // Append-only history subcollection for Follow-up
      match /followup_history/{historyId} {
        allow read: if isApprovedUser() && (
          isSuperAdmin() || 
          get(/databases/$(database)/documents/orcamentos/$(docId)).data.companyId == getUserData().companyId
        );
        allow create: if isApprovedUser() && (
          isSuperAdmin() || 
          (
            get(/databases/$(database)/documents/orcamentos/$(docId)).data.companyId == getUserData().companyId &&
            request.resource.data.companyId == getUserData().companyId &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.quoteId == docId
          )
        );
        allow update, delete: if false;
      }
    }

    // Measurements (medicoes)
    match /medicoes/{docId} {
      allow read: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow update: if isApprovedUser() && (
        isSuperAdmin() || 
        (resource.data.companyId == getUserData().companyId && (
          getUserData().role != 'medidor' ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'startedAt', 'completedAt', 'completedByStaffId', 'completedByStaffName', 
            'observations', 'updatedAt', 'notified10m', 'notified30m', 'notified1h',
            'environmentPhotos', 'technicalMeasurementPhotos', 'scheduledDate', 'scheduledTime', 'scheduledAt'
          ])
        ))
      );
      allow delete: if isApprovedUser() && (
        isSuperAdmin() || 
        (resource.data.companyId == getUserData().companyId && getUserData().role != 'medidor')
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        (request.resource.data.companyId == getUserData().companyId && getUserData().role != 'medidor')
      );
    }

    // Operational Logs (incidents)
    match /operational_logs/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
    }

    // Clients
    match /clients/{docId} {
      allow read: if isAuthenticated() && (
        request.auth.token.superadmin == true ||
        resource.data.companyId == request.auth.token.companyId ||
        (isApprovedUser() && (
          isSuperAdmin() || 
          resource.data.companyId == getUserData().companyId
        ))
      );
      
      allow create: if isAuthenticated() && (
        request.auth.token.superadmin == true ||
        request.resource.data.companyId == request.auth.token.companyId ||
        (isApprovedUser() && (
          isSuperAdmin() || 
          request.resource.data.companyId == getUserData().companyId
        ))
      );

      allow update: if isAuthenticated() && (
        request.auth.token.superadmin == true ||
        (
          resource.data.companyId == request.auth.token.companyId &&
          request.resource.data.companyId == resource.data.companyId &&
          (!('deletedAt' in resource.data) || 'deletedAt' in request.resource.data) &&
          (!('deletedBy' in resource.data) || 'deletedBy' in request.resource.data) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            (request.resource.data.status == 'deleted' && request.resource.data.deletedBy == request.auth.uid) ||
            (request.resource.data.status == 'active' && request.resource.data.restoredBy == request.auth.uid)
          )
        ) ||
        (isApprovedUser() && (
          isSuperAdmin() || 
          (
            resource.data.companyId == getUserData().companyId &&
            request.resource.data.companyId == resource.data.companyId &&
            (!('deletedAt' in resource.data) || 'deletedAt' in request.resource.data) &&
            (!('deletedBy' in resource.data) || 'deletedBy' in request.resource.data) &&
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
              (request.resource.data.status == 'deleted' && request.resource.data.deletedBy == request.auth.uid) ||
              (request.resource.data.status == 'active' && request.resource.data.restoredBy == request.auth.uid)
            )
          )
        ))
      );

      allow delete: if isSuperAdmin();

      match /history/{historyId} {
        allow read: if isApprovedUser() && (
          isSuperAdmin() || 
          get(/databases/$(database)/documents/clients/$(docId)).data.companyId == getUserData().companyId
        );
        allow create: if isApprovedUser() && (
          isSuperAdmin() || 
          (
            get(/databases/$(database)/documents/clients/$(docId)).data.companyId == getUserData().companyId &&
            request.resource.data.changedBy == request.auth.uid &&
            request.resource.data.clientId == docId &&
            request.resource.data.companyId == getUserData().companyId
          )
        );
        allow update, delete: if false;
      }
    }

    // Store Visits
    match /store_visits/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
    }

    // Store Visits Locks
    match /store_visits_locks/{lockId} {
      allow read, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        (
          request.resource.data.companyId == getUserData().companyId &&
          lockId == request.resource.data.companyId + "_" + request.resource.data.clientId + "_" + request.resource.data.visitDate + "_" + request.resource.data.visitTime &&
          request.resource.data.visitId is string &&
          request.resource.data.createdAt is string
        )
      );
      allow update: if isApprovedUser() && (
        isSuperAdmin() || 
        (
          resource.data.companyId == getUserData().companyId &&
          request.resource.data.companyId == getUserData().companyId &&
          request.resource.data.visitId is string &&
          request.resource.data.companyId == resource.data.companyId &&
          request.resource.data.clientId == resource.data.clientId &&
          request.resource.data.visitDate == resource.data.visitDate &&
          request.resource.data.visitTime == resource.data.visitTime
        )
      );
    }
    // Planned Projects
    match /planned_projects/{docId} {
      allow read, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
      allow update: if (isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      )) || (
        request.resource.data.signatureToken == resource.data.signatureToken &&
        request.resource.data.signatureStatus == 'signed' &&
        resource.data.signatureStatus in ['not_sent', 'active'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'signatureStatus', 'signedAt', 'signedByName', 'signedByDocument',
            'signatureImageUrl', 'signatureDataUrl', 'signedUserAgent', 'contractSignedSnapshot'
        ])
      );
    }

    // Planned Products
    match /planned_products/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
    }

    // Planned Catalog Items
    match /planned_catalog_items/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
    }

    // Influencers
    match /influencers/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
    }

    // Bonus Records
    match /bonus_records/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
    }


    // Invitations: 
    match /invites/{inviteId} {
      allow get: if resource.data.status == 'pending'; 
      allow list: if isAuthenticated() && isSuperAdmin();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().role in ['company_admin', 'admin'] && request.resource.data.companyId == getUserData().companyId)
      );
      allow update: if isAuthenticated() && 
                   request.auth.token.email == resource.data.email && 
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedByUid']) && 
                   request.resource.data.status == 'accepted';
      allow delete: if isAuthenticated() && isSuperAdmin();
    }

    // Security Logs: Immutable trail
    match /security_logs/{logId} {
      allow create: if true;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Company Names (Lock mechanism for unique registration)
    match /companyNames/{name} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // --- Catalog Collections (Stones, Services, Sinks) ---
    match /stones/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
      allow list: if isApprovedUser() && (
        isSuperAdmin() || 
        getUserData().companyId != null
      );
    }

    match /services/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
    }

    match /sinks/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
    }

    match /accessories/{docId} {
      allow read, update, delete: if isApprovedUser() && (
        isSuperAdmin() || 
        resource.data.companyId == getUserData().companyId
      );
      allow create: if isApprovedUser() && (
        isSuperAdmin() || 
        request.resource.data.companyId == getUserData().companyId
      );
    }

    // Public Contract Gateway: Access by token for anonymous signing
    match /public_contract_links/{tokenId} {
      allow get: if true;
      allow create: if isAuthenticated()
        && request.resource.data.token == tokenId
        && request.resource.data.active == true
        && request.resource.data.companyId == getUserData().companyId;

      allow update: if (
        (isAuthenticated() && (belongsToCompany(resource.data.companyId) || isSuperAdmin())) ||
        (
          resource.data.active == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'signedAt',
            'signatureData',
            'active'
          ]) &&
          request.resource.data.active == false
        )
      );

      allow list: if false;
    }

    // Public Contract Links for Planned Projects
    match /planned_public_contract_links/{tokenId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() && (
        isSuperAdmin() || request.resource.data.companyId == getUserData().companyId
      );
      allow update: if (isAuthenticated() && (
        isSuperAdmin() || resource.data.companyId == getUserData().companyId
      )) || (
        request.resource.data.status == 'used' &&
        resource.data.status == 'active' &&
        request.time < resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'usedAt', 'signedByName', 'signedByDocument', 'signatureImage', 'signedUserAgent'
        ])
      );
    }

    // Public Manager Signature Gateway: Get token metadata, create from dashboard, deny updates/deletes
    match /manager_signature_tokens/{tokenId} {
      allow get: if true;
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().role in ['company_admin', 'admin'] && request.resource.data.companyId == getUserData().companyId)
      );
      allow update, delete: if false;
    }

    // --- Catch-all for other collections ---
    match /{collection}/{docId} {
      allow read, write: if isApprovedUser() && (
        isSuperAdmin() || 
        (resource != null && resource.data.companyId == getUserData().companyId) ||
        (request.resource != null && request.resource.data.companyId == getUserData().companyId)
      );
      allow list: if isApprovedUser() && (
        isSuperAdmin() || 
        getUserData().companyId != null
      );
    }
  }
}